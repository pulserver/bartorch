[submodule "bart"]
	path = external/bart
	# pulserver/bart is the downstream integration fork bartorch builds from:
	# the upstream history unchanged, plus a small patch stack on its
	# `downstream` branch.  Canonical upstream is
	# https://codeberg.org/mrirecon/bart.git, mirrored on the fork's `master`.
	# docs/guides/developer/bart-fork.md describes the policy.
	url = https://github.com/pulserver/bart.git
	branch = downstream
